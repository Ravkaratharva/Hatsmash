# Existing site: public URL of the separately deployed scanner service.
SCANNER_SERVICE_URL=http://localhost:8788

# Hatsmash product authentication. Use a modern sb_publishable_ key only.
# These values are read on the server; no Supabase session or secret is
# exposed to browser JavaScript.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Cloudflare Turnstile bot protection. The site key is public. Configure the
# secret directly in Supabase Auth; never place it in this application.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# The rate-limit salt is a server-only deployment secret.
AUTH_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# Scanner service: paste the complete rediss:// TCP connection from Upstash.
REDIS_URL=rediss://default:replace-me@example.upstash.io:6379
# Scanner-only Postgres connection. Use Supabase Session Pooler on port 5432;
# do not use the IPv6-only Direct connection or port 6543 Transaction pooler.
DATABASE_URL=postgres://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_ANON_KEY=replace-with-anon-key
# SERVER ONLY: never prefix this with VITE_ or import it into frontend code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PORT=8788
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=true
RUN_SCAN_WORKER=true
FREE_SCANS_PER_IP=3
SCAN_WORKER_CONCURRENCY=1
LIGHTHOUSE_TIMEOUT_MS=75000
IP_HASH_SALT=replace-with-a-long-random-string

{
  "name": "hatsmash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:auth && npm run test:scanner",
    "test:auth": "node --test tests/auth-security.test.ts",
    "test:scanner": "npm run scanner:build && node --test .scanner-dist/services/scanner/heuristics/heuristics.test.js .scanner-dist/services/scanner/fix-prompts.test.js .scanner-dist/services/scanner/lighthouse-scan.test.js .scanner-dist/services/scanner/security-scan.test.js .scanner-dist/services/scanner/url-safety.test.js",
    "scanner:build": "tsc -p tsconfig.scanner.json",
    "scanner:dev": "tsx watch services/scanner/server.ts",
    "scanner:start": "node .scanner-dist/services/scanner/server.js",
    "scanner:smoke": "npm run scanner:build && node .scanner-dist/services/scanner/smoke.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fastify/cors": "^11.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "axe-core": "^4.13.0",
    "bullmq": "^6.1.2",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}

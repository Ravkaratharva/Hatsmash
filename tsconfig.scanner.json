{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".scanner-dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["db/schema.ts", "lib/scan-schema.ts", "services/scanner/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", ".vinext"]
}
